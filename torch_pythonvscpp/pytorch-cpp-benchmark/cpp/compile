#module load cudatoolkit/24.11_11.8

export TORCH_CUDA_ARCH_LIST="9.0"
export CUDACXX=$CUDA_HOME/bin/nvcc

CC=$(which gcc-12) CXX=$(which g++-12) cmake -B build \
  -DCMAKE_PREFIX_PATH=$(python -c 'import torch; print(torch.utils.cmake_prefix_path)') \
  -DCMAKE_BUILD_TYPE=Release \
  -DCUDA_TOOLKIT_ROOT_DIR=$CUDA_HOME \
  -DCUDAToolkit_ROOT=$CUDA_HOME \
  -DCUDA_CUDART_LIBRARY=$CUDA_HOME/targets/sbsa-linux/lib/libcudart.so \
  -DCUDA_INCLUDE_DIRS=$CUDA_HOME/targets/sbsa-linux/include \
  -DCMAKE_CUDA_HOST_COMPILER=$(which g++-12)
